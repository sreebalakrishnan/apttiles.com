# APT Tiles — server configuration for Hostinger (Apache / LiteSpeed).
#
# Every directive is wrapped in an <IfModule> guard, so a server missing one of
# these modules skips that block rather than returning a 500.

# ----------------------------------------------------------------------------
# Serve index.html for a directory request.
#
# Without this, https://apttiles.com/ returned 403 while
# https://apttiles.com/index.html loaded fine: the file was present and
# readable, but the server was not resolving the directory to it, and with
# listings disabled that is a 403 rather than a 404.
# ----------------------------------------------------------------------------
<IfModule mod_dir.c>
  DirectoryIndex index.html index.htm
</IfModule>

# ----------------------------------------------------------------------------
# MIME types. Current servers know these; older builds serve .webp as
# application/octet-stream, which makes every image download instead of render.
# ----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp    .webp
  AddType image/svg+xml .svg
  AddType font/woff2    .woff2
</IfModule>

# ----------------------------------------------------------------------------
# Compression. Text only — WebP, JPEG and PNG are already compressed, and
# running them through deflate costs CPU to make them very slightly larger.
# woff2 is likewise already compressed.
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------------
# Caching.
#
# HTML revalidates on every visit, so a Git push appears immediately rather
# than waiting out a cached copy. Images and the font are held for 30 days.
#
# Image filenames are stable — replacing a photograph reuses its name — so a
# returning visitor keeps the old copy for up to 30 days. To force an update
# sooner, rename the file (e.g. -800.webp -> -800-v2.webp) and update the
# reference in index.html.
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html     "access plus 0 seconds"
  ExpiresByType image/webp    "access plus 30 days"
  ExpiresByType image/jpeg    "access plus 30 days"
  ExpiresByType image/png     "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon  "access plus 30 days"
  ExpiresByType font/woff2    "access plus 30 days"
</IfModule>

# ----------------------------------------------------------------------------
# Keep the repository out of the web root.
#
# The Git integration checks out into the directory the site is served from, so
# .git sits alongside the site. Anything under it would otherwise be fetchable,
# and .git/config plus the pack files is enough to reconstruct the whole
# repository and its history.
#
# RedirectMatch is used rather than a rewrite rule: it is a single directive,
# it cannot loop, and 404 is a better answer than 403 because it does not
# confirm that the path exists. The pattern requires a slash immediately before
# the dot, so it matches /.git/config but not a file merely containing ".git"
# in its name. .well-known is untouched, so certificate renewal keeps working.
# ----------------------------------------------------------------------------
<IfModule mod_alias.c>
  RedirectMatch 404 "/\.(git|svn|hg|bzr|env|DS_Store)"
</IfModule>

# Documentation that ships with the repo but is not part of the site.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(md|yml|yaml)$">
    Require all denied
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# No directory listings. /assets/ and /assets/gallery/ have no index file, so
# without this a visitor could enumerate every file on the site.
#
# The <IfModule> guard below only covers the module being absent. It cannot
# protect against the host disallowing Options in .htaccess at all, which
# produces a 500 rather than a skipped directive. That makes this the riskiest
# block in the file — if the site errors after a deploy, delete it first.
# ----------------------------------------------------------------------------
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# ----------------------------------------------------------------------------
# Deliberately NOT here: an HTTPS redirect. Hostinger terminates TLS upstream,
# which makes %{HTTPS} unreliable and can cause a redirect loop that takes the
# whole site down. Use the "Force HTTPS" toggle in hPanel instead.
# ----------------------------------------------------------------------------
